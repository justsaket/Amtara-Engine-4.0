# ==============================================================================
# Antara Engine 4.0 — Phase 1–5 Complete Environment Configuration Reference
#
# ZERO-BLOCKER ARCHITECTURE:
# Antara Engine boots, renders, builds, and passes verification WITHOUT optional
# third-party credentials. The Autonomous Configuration Manager detects existing
# resources (environment variables, firebase-applet-config.json, ADC, Vercel env)
# and classifies every capability cleanly without blocking startup.
#
# SECURITY:
# - Never commit real secrets, service accounts, or OAuth tokens to git.
# - Never place server secrets in NEXT_PUBLIC_* variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application (Automatically inferred on Vercel / defaults to port 3000)
# ------------------------------------------------------------------------------
# PORT="3000"
# APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Internal Security Secrets (REQUIRED IN PRODUCTION / VERCEL)
# Auto-generated securely via CSPRNG into .antara/internal-secrets.json locally.
# On serverless hosts (Vercel), set durable values in Project Settings once.
# Never generated per-request or stored inside the same Firestore DB they protect.
# ------------------------------------------------------------------------------
# SESSION_SECRET=""
# ENCRYPTION_KEY=""
# ENCRYPTION_KEY_VERSION="v1"
#
# Strictly optional key-rotation variables — omit unless rotating an active key:
# ENCRYPTION_KEY_PREVIOUS=""
# ENCRYPTION_KEY_PREVIOUS_VERSION=""

# ------------------------------------------------------------------------------
# 3. Firebase Client & Admin SDK (REQUIRED FOR PRODUCTION PERSISTENCE & AUTH)
# Uses firebase-applet-config.json automatically when present; NEXT_PUBLIC_*
# variables override it cleanly for multi-environment Vercel deployments.
# Omit DATABASE_ID when using the default "(default)" Firestore database.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=""

# Firebase Admin SDK (Server-Only — supply EITHER Option A OR Option B):
# Option A (Recommended for Vercel / Serverless):
# FIREBASE_SERVICE_ACCOUNT_JSON=""
#
# Option B (Individual Fields):
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 4. Phase 3 AI Providers (Optional — configure at least one for live synthesis)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# AI_GATEWAY_URL=""
# AI_GATEWAY_API_KEY=""
# AI_DEFAULT_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 5. Phase 2 Google OAuth & Apps Script Control Plane (Optional)
# ------------------------------------------------------------------------------
# GOOGLE_INTEGRATION_CLIENT_ID=""
# GOOGLE_INTEGRATION_CLIENT_SECRET=""
# GOOGLE_INTEGRATION_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ------------------------------------------------------------------------------
# 6. Phase 4 Social Publishing, Creative & Engagement Channels (Optional)
# Each provider stays cleanly isolated as "Not Configured" until supplied.
# ------------------------------------------------------------------------------
# Meta (Instagram, Facebook Pages, WhatsApp Business, Meta Ads):
# META_APP_ID=""
# META_APP_SECRET=""
# META_WEBHOOK_VERIFY_TOKEN=""
#
# LinkedIn Marketing / Community Management:
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
#
# TikTok Content Posting API:
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_WEBHOOK_SECRET=""
#
# Canva Connect API:
# CANVA_CLIENT_ID=""
# CANVA_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. Scheduled Dispatcher & Cron Authentication (Recommended on Vercel)
# Used by /api/cron/publish-dispatcher (vercel.json runs every 5 minutes).
# ------------------------------------------------------------------------------
# CRON_SECRET=""

# ------------------------------------------------------------------------------
# 8. Automated Test Controls (NEVER enable live Google/social writes in CI)
# ------------------------------------------------------------------------------
ENABLE_REAL_GOOGLE_INTEGRATION_TESTS="false"
