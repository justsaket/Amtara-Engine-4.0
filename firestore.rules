        allow create, update: if isValidId(workspaceId) && isValidId(policyId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, policyId);
        allow delete: if false;
      }

      match /analyticsSnapshots/{snapshotId} {
        allow get: if isValidId(workspaceId) && isValidId(snapshotId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create: if isValidId(workspaceId) && isValidId(snapshotId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager', 'editor']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, snapshotId);
        allow update, delete: if false;
      }

      match /performanceExperiments/{experimentId} {
        allow get: if isValidId(workspaceId) && isValidId(experimentId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create, update: if isValidId(workspaceId) && isValidId(experimentId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager', 'editor']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, experimentId);
        allow delete: if hasWorkspaceRole(workspaceId, ['owner', 'admin']);
      }

      match /marketingActivities/{activityId} {
        allow get: if isValidId(workspaceId) && isValidId(activityId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create: if isValidId(workspaceId) && isValidId(activityId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager', 'editor']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, activityId);
        allow update, delete: if false;
      }

      match /autopilotPolicies/{policyId} {
        allow get: if isValidId(workspaceId) && isValidId(policyId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create, update: if isValidId(workspaceId) && isValidId(policyId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, policyId);
        allow delete: if hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager']);
      }

      match /autopilotFiles/{fileId} {
        allow get: if isValidId(workspaceId) && isValidId(fileId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create, update: if isValidId(workspaceId) && isValidId(fileId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager', 'editor']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, fileId);
        allow delete: if hasWorkspaceRole(workspaceId, ['owner', 'admin']);
      }

      match /autopilotJobs/{jobId} {
        allow get: if isValidId(workspaceId) && isValidId(jobId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create, update: if isValidId(workspaceId) && isValidId(jobId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, jobId);
        allow delete: if hasWorkspaceRole(workspaceId, ['owner', 'admin']);
      }

      match /autopilotEvents/{eventId} {
        allow get: if isValidId(workspaceId) && isValidId(eventId) && isActiveMember(workspaceId);
        allow list: if isValidId(workspaceId) && resource.data.workspaceId == workspaceId && isActiveMember(workspaceId);
        allow create: if isValidId(workspaceId) && isValidId(eventId) &&
          hasWorkspaceRole(workspaceId, ['owner', 'admin', 'manager', 'editor']) &&
          isValidPhase3WorkspaceDoc(incoming(), workspaceId, eventId);
        allow update, delete: if false;
      }
    }

    match /_serverVault/{docId} {
      allow read, write: if false;
    }
  }
}
